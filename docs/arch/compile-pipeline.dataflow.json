    {
      "id": "f-codegen-as",
      "from": "codegen",
      "to": "as",
      "label": "汇编 .s",
      "classification": "AT&T 语法"
    },
    {
      "id": "f-as-linker",
      "from": "as",
      "to": "linker",
      "label": "目标文件 .o",
      "classification": "ELF 重定位"
    },
    {
      "id": "f-linker-exe",
      "from": "linker",
      "to": "exe",
      "label": "可执行文件",
      "classification": "非 PIE"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "阶段切分",
      "items": [
        "七个阶段各自有中文日志横幅与可观测产物",
        "-E 只跑到预处理；-S 只出汇编不链接",
        "任何阶段抛异常即终止，诊断带行列号"
      ]
    },
    {
      "dot": "emerald",
      "title": "模板引擎",
      "items": [
        "函数模板走实参推导，算法是合一",
        "类模板走形参替换，产出具体类型",
        "实例名带作用域，符号按 Itanium 修饰"
      ]
    },
    {
      "dot": "amber",
      "title": "自研链接器",
      "items": [
        "合并节、决议符号、回填重定位",
        "内置 _start 与 64KB bump 分配器",
        "不依赖系统 ld / crt / libc"
      ]
    }
  ]
}
